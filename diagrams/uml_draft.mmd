classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +str task_id
        +str pet_name
        +mark_complete() void
        +mark_incomplete() void
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) void
        +remove_task(task_id: str) bool
        +get_tasks() list~Task~
    }

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet: Pet) void
        +remove_pet(pet_name: str) bool
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +list~Task~ schedule
        +retrieve_tasks(owner: Owner) list~Task~
        +organize_tasks(owner: Owner) list~Task~
        +build_schedule(owner: Owner) list~Task~
        +complete_task(owner: Owner, task_id: str) bool
    }

    Owner "1" --> "0..*" Pet : manages
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : retrieves get_all_tasks()
    Scheduler --> Task : organizes
